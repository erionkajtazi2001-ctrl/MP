<Window x:Class="MagicPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magic Panel" Width="400" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#12141A" Foreground="#E6E8EE"
        FontFamily="Segoe UI" Icon="Assets/app.ico"
        Topmost="{Binding IsChecked, ElementName=TopmostCheck}">

    <Window.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B92A5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="#12141A"/>
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="CaretBrush" Value="#E6E8EE"/>
            <Setter Property="BorderBrush" Value="#2A2F3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4C8DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8B92A5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#1B1E27" CornerRadius="6" Margin="2" Padding="0,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#262B38"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4C8DFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TradeButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#2A2F3C" CornerRadius="6" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#363C4D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="14">
        <StackPanel>

            <!-- Header -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MAGIC PANEL" FontSize="16" FontWeight="Bold"/>
                    <Border Background="#3A2F12" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ModeBadge" Text="SIM · MANUAL DATA" Foreground="#F5B83D" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <CheckBox x:Name="TopmostCheck" Content="Stay on top" IsChecked="True"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8B92A5"/>
            </Grid>

            <!-- Instrument tabs -->
            <UniformGrid Columns="4" Margin="-2,12,-2,0">
                <RadioButton x:Name="TabNQ"  GroupName="Instruments" Content="NQ"  Tag="NQ"  Style="{StaticResource TabButton}" Checked="OnInstrumentChecked"/>
                <RadioButton x:Name="TabMNQ" GroupName="Instruments" Content="MNQ" Tag="MNQ" Style="{StaticResource TabButton}" Checked="OnInstrumentChecked"/>
                <RadioButton x:Name="TabGC"  GroupName="Instruments" Content="GC"  Tag="GC"  Style="{StaticResource TabButton}" Checked="OnInstrumentChecked"/>
                <RadioButton x:Name="TabMGC" GroupName="Instruments" Content="MGC" Tag="MGC" Style="{StaticResource TabButton}" Checked="OnInstrumentChecked"/>
            </UniformGrid>
            <TextBlock x:Name="SpecText" Style="{StaticResource Muted}" Margin="2,6,0,0"/>

            <!-- Market data (manual until the NinjaTrader bridge exists) -->
            <Border Background="#1B1E27" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="MARKET DATA (manual until NinjaTrader link, Phase 5)" Style="{StaticResource Muted}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Expected entry" Style="{StaticResource Muted}"/>
                            <TextBox x:Name="EntryBox" Text="25000.00" Style="{StaticResource Input}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Candle high" Style="{StaticResource Muted}"/>
                            <TextBox x:Name="HighBox" Text="25005.00" Style="{StaticResource Input}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Candle low" Style="{StaticResource Muted}"/>
                            <TextBox x:Name="LowBox" Text="24990.00" Style="{StaticResource Input}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Settings -->
            <Border Background="#1B1E27" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="SETTINGS (saved)" Style="{StaticResource Muted}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Max risk $" Style="{StaticResource Muted}"/>
                            <TextBox x:Name="MaxRiskBox" Style="{StaticResource Input}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SL offset (ticks)" Style="{StaticResource Muted}"/>
                            <TextBox x:Name="OffsetBox" Style="{StaticResource Input}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Comm $/contract" Style="{StaticResource Muted}"/>
                            <TextBox x:Name="CommissionBox" Style="{StaticResource Input}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Slippage (ticks)" Style="{StaticResource Muted}"/>
                            <TextBox x:Name="SlippageBox" Style="{StaticResource Input}"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="Save settings" Style="{StaticResource SmallButton}"
                            HorizontalAlignment="Right" Margin="0,10,0,0" Click="SaveSettings_Click"/>
                </StackPanel>
            </Border>

            <!-- BUY / SELL -->
            <UniformGrid Columns="2" Margin="-4,10,-4,0">
                <Button x:Name="BuyButton" Content="BUY" Background="#1FBF75" Height="64" Margin="4"
                        Style="{StaticResource TradeButton}" Click="BuyButton_Click"/>
                <Button x:Name="SellButton" Content="SELL / SHORT" Background="#E5484D" Height="64" Margin="4"
                        Style="{StaticResource TradeButton}" Click="SellButton_Click"/>
            </UniformGrid>

            <!-- Results -->
            <Border Background="#1B1E27" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="TRADE CALCULATION" Style="{StaticResource Muted}"/>
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="#8B92A5" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#E6E8EE"
                                               FontWeight="SemiBold" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Calculation only. No orders are sent." Style="{StaticResource Muted}"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
